{
  "name": "stardew-i18n-translator",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "description": "Local desktop tool for Stardew Valley / SMAPI mod i18n translations.",
  "license": "GPL-3.0-or-later",
  "author": "Nana",
  "repository": "https://github.com/Nana1873/stardew-i18n-translator",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "tsc && vite build",
    "build": "tsc && vite build && tauri build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:desktop:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-e2e/setup.ps1",
    "test:desktop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-e2e/run.ps1",
    "test:desktop:release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-e2e/run.ps1 -ReleaseCases -Layout -Stress -LiveAi both",
    "test:desktop:matrix": "node scripts/desktop-e2e/check-matrix.mjs",
    "test:desktop:guards": "node --test scripts/desktop-e2e/check-matrix.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version:set": "node scripts/set-version.mjs",
    "check:versions": "node scripts/check-version-sync.mjs",
    "check:links": "node scripts/check-markdown-links.mjs",
    "test:links": "node --test scripts/check-markdown-links.test.mjs",
    "check:docs": "node scripts/check-version-sync.mjs && node --test scripts/check-markdown-links.test.mjs && node scripts/check-markdown-links.mjs && prettier --check .",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.5",
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "selenium-webdriver": "4.49.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
